# Copy to .env and fill in.  .env is gitignored — never commit it.

# ─── database (required) ────────────────────────────────────────────────────
# Postgres from docker-compose.yml. Port 5433 avoids clashing with a local server.
DATABASE_URL=postgresql+psycopg://bhav:bhav@localhost:5433/bhav
# Redis from docker-compose.yml. Bot session state only (Phase 9).
REDIS_URL=redis://localhost:6380/0

# ─── data.gov.in / Agmarknet (required from Phase 2) ────────────────────────
# Your personal API key from data.gov.in → My Account → API Key.
DATA_GOV_IN_API_KEY=
# Resource UUID of the "Current Daily Price of Various Commodities" dataset.
AGMARKNET_RESOURCE_ID=

# ─── WhatsApp Cloud API (required from Phase 11, leave blank until then) ────
# Test phone number ID from the Meta app dashboard → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID from the same page.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Temporary access token — expires every 24h, regenerate on demo morning.
WHATSAPP_ACCESS_TOKEN=
# App Secret from Meta app dashboard → App Settings → Basic.
WHATSAPP_APP_SECRET=
# Any random string you invent; you type the same one into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=

# ─── frontend ───────────────────────────────────────────────────────────────
# Base URL the Next.js app calls the FastAPI backend on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
